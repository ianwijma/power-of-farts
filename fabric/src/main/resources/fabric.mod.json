{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {},
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.ianwijma.poweroffarts.fabric.PowerOfFartsFabric"
        ],
        "client": [
            "com.ianwijma.poweroffarts.fabric.client.PowerOfFartsFabricClient"
        ]
    },
    "mixins": [
        "poweroffarts.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "jei": "*",
        "jade": "*"
    }
}
